# Copy to ~/.config/project-hub/ai.env on the server, never to shared storage.
PROJECT_HUB_AI_ENABLED=false
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/home/khb/.config/project-hub/google-ai-service-account.json
PROJECT_HUB_AI_MODEL=gemini-3.1-flash-lite
PROJECT_HUB_AI_STATE=/home/khb/.local/state/project-hub-ai
PROJECT_HUB_AI_DAILY_LIMIT=20
PROJECT_HUB_AI_MONTHLY_LIMIT=300
